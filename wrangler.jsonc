{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandlab",
  "compatibility_date": "2026-07-16",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandlab-gallery",
      "database_id": "75e9cf5f-82b9-4784-9a5b-cec215df3909"
    }
  ],
  // 커스텀 도메인. Cloudflare Registrar로 구매해 계정 내 zone이므로 배포 시 DNS+인증서 자동 발급.
  "routes": [{ "pattern": "sandlab.app", "custom_domain": true }],
  // 배급 퍼널 계측 (Analytics Engine) — 2026-07-20 대시보드에서 활성화됨. share_open/upload/vote를
  // referrer host와 함께 집계(쿠키·동의배너 0). 대시보드에서 dataset 'sandlab_events' 조회.
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "sandlab_events" }]
}
