{
  "name": "sandlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3120",
    "build": "next build",
    "build:prod": "NEXT_PUBLIC_UI=${SANDLAB_UI:-next} NEXT_PUBLIC_READ_ONLY= NEXT_PUBLIC_NOINDEX= next build",
    "build:preview": "NEXT_PUBLIC_UI=next NEXT_PUBLIC_READ_ONLY=1 NEXT_PUBLIC_NOINDEX=1 next build && NEXT_PUBLIC_UI=next node scripts/preview-headers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "spill:verify": "npx tsx scripts/spill-verify.ts",
    "deploy": "pnpm run build:prod && node scripts/verify-ads.mjs && wrangler deploy",
    "deploy:preview": "pnpm run build:preview && node scripts/verify-ads.mjs --preview && wrangler deploy --env preview",
    "lint:ui": "node scripts/lint-ui-rules.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "qa:gallery": "node scripts/qa/gallery-e2e.cjs",
    "qa:preview": "node scripts/qa/preview.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.50.8",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@webgpu/types": "^0.1.52",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
