// 아이콘 레지스트리(src/ui-next/icons/icons.ts) → public/ui-next/icons.svg 스프라이트.
//   npx tsx scripts/gen-icons.mts           # 생성
//   npx tsx scripts/gen-icons.mts --check   # 파일이 낡았으면 exit 1
// 미리보기 시트 docs/design/redesign-v2/icons-sheet.html도 같이 만든다(스프라이트 인라인).
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { GRAIN_EXCEPTIONS, ICON_NAMES, spriteSvg } from '../src/ui-next/icons/icons.ts'

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')

function sheetHtml(): string {
  const cell = (n: string) =>
    `<figure><div class="s">${[20, 24, 40]
      .map((px) => `<svg width="${px}" height="${px}" aria-hidden="true"><use href="#i-${n}"/></svg>`)
      .join('')}</div><figcaption>${n}${n in GRAIN_EXCEPTIONS ? ' <i>no dot</i>' : ''}</figcaption></figure>`
  const grid = ICON_NAMES.map(cell).join('')
  const big = ICON_NAMES.map(
    (n) => `<figure><svg class="big" width="80" height="80" aria-hidden="true"><use href="#i-${n}"/></svg><figcaption>${n}</figcaption></figure>`,
  ).join('')
  return `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sandlab icon sheet</title>
<!-- generated by scripts/gen-icons.mts - do not edit -->
<style>
:root{--bone:#F4ECDD;--bone-line:#D9CBB2;--ink:#2A2118;--ink-2:#5E5040;--kiln:#07090D;--kiln-ink:#EFE6D6}
*{box-sizing:border-box}
body{margin:0;background:var(--bone);color:var(--ink);font:13px/1.4 ui-monospace,Menlo,monospace}
h1{font-size:16px;margin:0;padding:20px 24px 8px}
p.note{margin:0;padding:0 24px 16px;color:var(--ink-2)}
section{padding:20px 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px 12px}
section.kiln{background:var(--kiln);color:var(--kiln-ink)}
section.inspect{grid-template-columns:repeat(auto-fill,minmax(96px,1fr))}
figure{margin:0}
.s{display:flex;align-items:flex-end;gap:12px;height:44px}
figcaption{margin-top:6px;font-size:11px;letter-spacing:.04em;opacity:.8}
figcaption i{font-style:normal;opacity:.6}
svg.big{background-color:#fff;background-image:linear-gradient(rgba(42,33,24,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(42,33,24,.08) 1px,transparent 1px);background-size:4px 4px;outline:1px solid var(--bone-line)}
@media (max-width:420px){h1,p.note,section{padding-left:16px;padding-right:16px}}
</style></head><body>
${spriteSvg()}
<h1>Glass &amp; Grain icons v1 (${ICON_NAMES.length})</h1>
<p class="note">20px grid, 2px stroke, round caps, currentColor, one grain dot (r=1.25). Sizes 20 / 24 / 40.</p>
<section class="bone">${grid}</section>
<section class="kiln">${grid}</section>
<section class="inspect">${big}</section>
</body></html>
`
}

const targets = [
  { path: resolve(root, 'public/ui-next/icons.svg'), want: spriteSvg() + '\n' },
  { path: resolve(root, 'docs/design/redesign-v2/icons-sheet.html'), want: sheetHtml() },
]

if (process.argv.includes('--check')) {
  const stale = targets.filter((t) => {
    try {
      return readFileSync(t.path, 'utf8') !== t.want
    } catch {
      return true
    }
  })
  if (stale.length) {
    for (const t of stale) console.error(`stale: ${t.path.slice(root.length + 1)}`)
    console.error('run: npx tsx scripts/gen-icons.mts')
    process.exit(1)
  }
  console.log(`icons up to date (${ICON_NAMES.length} icons)`)
} else {
  for (const t of targets) {
    mkdirSync(dirname(t.path), { recursive: true })
    writeFileSync(t.path, t.want)
    console.log(`wrote ${t.path.slice(root.length + 1)} (${t.want.length} bytes)`)
  }
}
