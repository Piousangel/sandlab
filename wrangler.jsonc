{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandlab",
  "compatibility_date": "2026-07-16",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandlab-gallery",
      "database_id": "75e9cf5f-82b9-4784-9a5b-cec215df3909"
    }
  ],
  // 커스텀 도메인. Cloudflare Registrar로 구매해 계정 내 zone이므로 배포 시 DNS+인증서 자동 발급.
  "routes": [{ "pattern": "sandlab.app", "custom_domain": true }],
  // 배급 퍼널 계측 (Analytics Engine) — 2026-07-20 대시보드에서 활성화됨. share_open/upload/vote를
  // referrer host와 함께 집계(쿠키·동의배너 0). 대시보드에서 dataset 'sandlab_events' 조회.
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "sandlab_events" }],
  // 리디자인 프리뷰(S6, docs/plans/2026-11-19-redesign-v2.md): `pnpm run deploy:preview`가 `--env preview`로 올린다.
  // 위 최상위(prod) 설정은 그대로 — `wrangler deploy`(env 없음)는 이 블록을 읽지 않는다.
  // routes·d1·AE·vars는 env로 상속되지 않아 여기서 다시 적는다:
  //  - 도메인 없음: <name>.<계정>.workers.dev에만 뜬다(sandlab.app에 붙지 않음).
  //  - 같은 D1 = 같은 API(계획 S6). 대신 READ_ONLY=1로 쓰기 차단(오너 11-20): /api/*의 GET·HEAD 외 요청은 워커가
  //    403 {"error":"preview is read-only"}(worker/preview.ts) → 프리뷰에서 씬·투표·데일리 기록이 prod 데이터에 섞이지 않는다.
  //  - AE 없음: 프리뷰 트래픽이 prod 지표(sandlab_events)를 오염하지 않게. 계측은 no-op.
  //  - NOINDEX=1: 워커 응답에 X-Robots-Tag(worker/preview.ts). 정적 에셋은 out/_headers, robots.txt 전체 차단.
  "env": {
    "preview": {
      "name": "sandlab-preview",
      "workers_dev": true,
      "routes": [],
      "vars": { "NOINDEX": "1", "READ_ONLY": "1" },
      "analytics_engine_datasets": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sandlab-gallery",
          "database_id": "75e9cf5f-82b9-4784-9a5b-cec215df3909"
        }
      ]
    }
  }
}
